<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/WslDock.ico</ApplicationIcon>
    <AssemblyName>WslDock</AssemblyName>
    <Version>0.3.7</Version>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Backend/wsl_bridge.py" />
    <EmbeddedResource Include="Assets/TrayWhite.ico" />
    <EmbeddedResource Include="Assets/TrayLight.ico" />
    <Resource Include="Assets/WslDock.png" />
  </ItemGroup>
</Project>
